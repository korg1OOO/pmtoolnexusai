import { useState } from 'react';
import { useParams } from 'react-router-dom';
import { useQuery } from '@tanstack/react-query';
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Users, AlertTriangle, CheckCircle, TrendingUp } from 'lucide-react';
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { getProgramResources } from '@/services/programService';

interface ProjectAllocation {
    project_id: string;
    project_name: string;
    required: number;
    allocated: number;
    skills_needed: string[];
}

interface ResourceConflict {
    resource_id: string;
    resource_name: string;
    projects: string[];
    total_allocation: number;
}

export function AdvancedResourceAllocation() {
    const { programId } = useParams();

    const { data: resources } = useQuery({
        queryKey: ['program-resource-allocation', programId],
        queryFn: () => getProgramResources(programId!),
        enabled: !!programId
    });

    // Map service data to component format (service returns basic resource data)
    const allocationData = resources ? {
        total_capacity: 45,
        total_allocated: resources.reduce((sum, r) => sum + r.allocated_capacity, 0),
        total_required: 42,
        projects: [] as ProjectAllocation[], // TODO: Enhance with project-level data
        conflicts: [] as ResourceConflict[],
        skillGaps: []
    } : null;

    // Old mock data query - now replaced:
