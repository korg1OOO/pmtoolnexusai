                                    />
                                </div>
                            </div>
                        ))}
                    </div>
                </Card>
            </div>

{/* Project Details */ }
<Card className="p-6">
    <h2 className="text-xl font-semibold mb-4">Project Allocation Details</h2>
    <div className="space-y-4">
        {allocationData?.projects.map((project) => {
            const gap = project.required - project.allocated;
            const allocationPercent = (project.allocated / project.required) * 100;

            return (
                <div key={project.project_id} className="border rounded-lg p-4">
                    <div className="flex items-center justify-between mb-3">
                        <h3 className="font-semibold">{project.project_name}</h3>
                        {gap > 0 ? (
                            <span className="text-sm px-2 py-1 bg-red-100 text-red-700 rounded">
                                Gap: {gap} resources
                            </span>
                        ) : (
                            <span className="text-sm px-2 py-1 bg-green-100 text-green-700 rounded">
                                Fully Allocated
                            </span>
                        )}
                    </div>

                    <div className="grid grid-cols-2 gap-4 mb-3 text-sm">
                        <div>
                            <p className="text-muted-foreground">Required</p>
                            <p className="font-semibold">{project.required} resources</p>
                        </div>
                        <div>
                            <p className="text-muted-foreground">Allocated</p>
                            <p className="font-semibold">{project.allocated} resources</p>
                        </div>
                    </div>

                    <div className="mb-3">
                        <p className="text-sm text-muted-foreground mb-1">Skills Needed</p>
                        <div className="flex flex-wrap gap-1">
